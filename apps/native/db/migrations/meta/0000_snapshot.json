        "accounts_anchor_status_balance_nullability_check": {
          "name": "accounts_anchor_status_balance_nullability_check",
          "value": "(\"accounts\".\"anchor_status\" = 'reported' AND \"accounts\".\"balance_minor_units\" IS NOT NULL AND \"accounts\".\"estimated_balance_minor_units\" IS NOT NULL)\n       OR (\"accounts\".\"anchor_status\" = 'unreported' AND \"accounts\".\"balance_minor_units\" IS NULL AND \"accounts\".\"estimated_balance_minor_units\" IS NULL)"
