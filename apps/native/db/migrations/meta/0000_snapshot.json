          "value": "\"accounts\".\"captured_transaction_count\" != 0 OR (\"accounts\".\"captured_income_minor_units\" = 0 AND \"accounts\".\"captured_expense_minor_units\" = 0 AND \"accounts\".\"captured_change_minor_units\" = 0)"
