# Read by packages/infra/alchemy.run.ts (alchemy dev / alchemy deploy).

# Neon primary database. Pooled string for the Worker; use the direct
# (non-pooled) string when running `pnpm db:migrate`.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection used only by the migration CLI, not bound to the Worker.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Web is not deployed unless explicitly requested.
# DEPLOY_WEB=true
# Enable custom CPU ceilings only after choosing Workers Paid in Cloudflare.
# WORKERS_PAID_PLAN=true

# Better Auth. BETTER_AUTH_URL is the API's public origin.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Public gateway hostname (deployed stages). When set, the gateway is served only
# there, with no workers.dev URL. Leave unset locally (localhost:3000).
# API_DOMAIN=api.zeeya.app
# Native EXPO_PUBLIC_SERVER_URL and web VITE_SERVER_URL must use this gateway
# origin, as must BETTER_AUTH_URL. The backend has no public deployment URL.
# Parent domain so the web app on zeeya.app receives the session cookie.
# COOKIE_DOMAIN=zeeya.app

# Sign in with Google: OAuth client IDs from one Google Cloud project
# (Web, iOS, Android). The app's native Google sign-in uses the web ID too.
# GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# Required only for browser Google sign-in; never expose this in client env.
# GOOGLE_CLIENT_SECRET=your-google-web-oauth-secret
# Google authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com

# Sign in with Apple (iOS): the app's bundle ID, with the Sign in with Apple
# capability enabled for it in the Apple Developer account.
# APPLE_APP_BUNDLE_IDENTIFIER=com.zeeya.app

# Sentry DSN (errors only, no request data). Unset disables reporting.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
